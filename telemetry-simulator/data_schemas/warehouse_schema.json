{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WarehouseTelemetry",
  "type": "object",
  "properties": {
    "warehouse_id": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "dock_status": {"type": "string", "enum": ["occupied", "free"]},
    "sensor_readings": {
      "type": "object",
      "properties": {
        "temperature_c": {"type": "number"},
        "humidity_pct": {"type": "number"},
        "door_open": {"type": "boolean"}
      }
    },
    "network_metadata": {
      "type": "object",
      "properties": {
        "firewall_alerts": {"type": "array", "items": {"type": "string"}},
        "dpi_flags": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "required": ["warehouse_id", "timestamp", "dock_status"]
}
